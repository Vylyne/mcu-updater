{
  "_comment": "Guards that must stay load-bearing. Run: ./scripts/mutation_test.py scripts/mutations/bulk-operations.json  --  one behaviour area, three files: the agent submits and batches, the provider package selects.",
  "file": "src/mcu_updater/agent/methods/bulk.py",
  "command": [
    "python",
    "-m",
    "pytest",
    "tests/test_agent_bulk.py",
    "-q"
  ],
  "mutations": [
    {
      "name": "offline boards are never flashed",
      "find": "                if state == STATE_OFFLINE:\n                    continue\n",
      "replace": ""
    },
    {
      "name": "scope 'all' overrides the version judgement",
      "find": "if scope == \"all\" or info[\"needs_flash\"] is True:",
      "replace": "if info[\"needs_flash\"] is True:"
    },
    {
      "name": "each board is waited for after its write",
      "file": "src/mcu_updater/flashers/flashtool.py",
      "find": "        if bench.settings.dry_run:\n            return\n        try:\n            wait_for_device(",
      "replace": "        if True:\n            return\n        try:\n            wait_for_device("
    },
    {
      "name": "a write that needs no stop stays outside the outage",
      "file": "src/mcu_updater/flashers/registry.py",
      "find": "        (stopped if by_name(target.flasher).needs_klipper_stopped else free).append(\n            target\n        )",
      "replace": "        stopped.append(target)"
    },
    {
      "name": "a batch settles each device after writing it",
      "find": "                        flasher.settled(bench, target, ctx)",
      "replace": "                        pass  # settled",
      "file": "src/mcu_updater/flashers/batch.py"
    },
    {
      "name": "update_all re-checks the idle gate after building",
      "find": "            assert_printer_idle(\n                settings,\n                activity=self._printer_activity,\n                force=bool(args.get(\"force\")),\n                reporter=ctx.reporter,\n            )\n",
      "replace": ""
    },
    {
      "name": "an unknown scope is refused",
      "find": "if scope not in self.SCOPES:",
      "replace": "if False:"
    },
    {
      "name": "update_all rebuilds every family, not just klipper",
      "find": "        targets = self._build_targets(install, scope, only).build",
      "replace": "        targets = self._build_targets(install, scope, only, fw=\"klipper\").build"
    },
    {
      "name": "a fleet build covers every family each type runs",
      "file": "src/mcu_updater/providers/kconfig_make.py",
      "find": "            for family in install.registry.get(name).families():",
      "replace": "            for family in [\"klipper\"]:"
    },
    {
      "name": "a fleet build reaches every build system",
      "file": "src/mcu_updater/providers/registry.py",
      "find": "PROVIDERS: tuple[Provider, ...] = (KconfigMake(), PlatformIO())",
      "replace": "PROVIDERS: tuple[Provider, ...] = (KconfigMake(),)"
    },
    {
      "name": "fw filters a fleet build rather than forcing a family",
      "file": "src/mcu_updater/providers/registry.py",
      "find": "            if fw is not None and target.fw != fw:\n                continue",
      "replace": "            if False:\n                continue"
    },
    {
      "name": "a sweep never rebuilds the bootloader",
      "file": "src/mcu_updater/providers/registry.py",
      "find": "            if fw is None and target.on_demand:\n                continue",
      "replace": "            if False:\n                continue"
    },
    {
      "name": "an unbuildable target is skipped, not attempted",
      "file": "src/mcu_updater/providers/registry.py",
      "find": "            if reason is not None:\n                out.skipped.append(Skipped(target, reason))\n                continue",
      "replace": "            if False:\n                out.skipped.append(Skipped(target, reason))\n                continue"
    }
  ]
}
