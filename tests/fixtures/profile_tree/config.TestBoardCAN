CONFIG_LOW_LEVEL_OPTIONS=y
# CONFIG_MACH_RP2040 is not set
CONFIG_MACH_STM32=y
# CONFIG_MACH_STM32F072 is not set
CONFIG_MACH_STM32G431=y
# CONFIG_STM32_CLOCK_REF_8M is not set
CONFIG_STM32_CLOCK_REF_24M=y
# CONFIG_STM32_FLASH_START_0000 is not set
CONFIG_STM32_FLASH_START_2000=y
# CONFIG_STM32_FLASH_START_8000 is not set
CONFIG_FLASH_APPLICATION_ADDRESS=0x8002000
# CONFIG_STM32_USB_PA11_PA12 is not set
CONFIG_STM32_CANBUS_PA11_PA12=y
CONFIG_CANSERIAL=y
CONFIG_CANBUS_FREQUENCY=1000000
CONFIG_CLOCK_FREQ=170000000
CONFIG_SCANNER=y
# CONFIG_CARTOGRAPHER_ENABLE is not set
CONFIG_CARTOGRAPHER_G431_ENABLE=y
# CONFIG_FOR_K1 is not set
CONFIG_VERSION="TESTFW 6.2.0"
